{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Goliath-Research/astra-ground-station-py/tests/golden/case.schema.json",
  "title": "Astra Win64 golden fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "case_id",
    "suite",
    "description",
    "harness",
    "inputs",
    "expected"
  ],
  "properties": {
    "format_version": { "const": 1 },
    "case_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "suite": {
      "enum": ["codec", "telemetry_decoder", "telemetry_encoder", "exporter"]
    },
    "description": { "type": "string", "minLength": 1 },
    "harness": { "$ref": "#/$defs/harness" },
    "inputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/file" }
    },
    "expected": {
      "oneOf": [
        { "$ref": "#/$defs/expected_fields" },
        { "$ref": "#/$defs/expected_bytes" }
      ]
    }
  },
  "$defs": {
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "git_sha", "harness_version", "built_at", "platform"],
      "properties": {
        "repo": { "const": "Goliath-Research/astra-ground-station" },
        "git_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "harness_version": { "type": "string", "minLength": 1 },
        "built_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
        "platform": { "const": "win64" }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "sha256"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "path": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "expected_fields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "fields"],
      "properties": {
        "kind": { "const": "fields" },
        "fields": { "type": "object" }
      }
    },
    "expected_bytes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "file"],
      "properties": {
        "kind": { "const": "bytes" },
        "file": { "$ref": "#/$defs/file" }
      }
    }
  }
}
