# Copy to /etc/astra/astra.env and replace the password.
# Do not commit production secrets. .env files are gitignored.

DATABASE_URL=postgresql://astra:CHANGE_ME@127.0.0.1:5432/astra
ASTRA_SCHEMA_DIR=/opt/astra-ground-station/database/schema

# Bridge UDP listen port. TMoIP forwards reassembled frames here and listens
# on this port plus the stage number (stage 1 is this value + 1).
# 2357 is the legacy Delphi literal, used only when this is unset.
ASTRA_BRIDGE_PORT=2357

# How many stages to decode. The first vehicle had two. Decoder ports are
# ASTRA_BRIDGE_PORT+1 through ASTRA_BRIDGE_PORT+ASTRA_STAGE_COUNT.
ASTRA_STAGE_COUNT=2

# Published by the bridge process once the OPC UA server is ported.
ASTRA_OPCUA_ENDPOINT=opc.tcp://0.0.0.0:4840/astra/

# FastAPI process. Defaults are 127.0.0.1 and 8080.
ASTRA_WEB_HOST=127.0.0.1
ASTRA_WEB_PORT=8080

# Bearer token for /api. GET /health stays open. Use at least 16 characters.
# Do not reuse the database password or a Servers.Password value.
ASTRA_WEB_TOKEN=replace-with-16-plus-chars

# Leave unset, or set to python. "mojo" is rejected until pack_records exists.
# ASTRA_NATIVE_BACKEND=python
